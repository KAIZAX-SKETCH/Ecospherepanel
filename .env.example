# Copy this file to .env and fill in your own values.
# Never commit .env or share provider secrets publicly.
FLASK_SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
DATABASE_PATH=ecosphere.sqlite3
PORT=5000

# Twilio Verify (recommended for OTP; Twilio generates and verifies the OTP)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace_with_your_twilio_auth_token
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID (Web application)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Set COOKIE_SECURE=1 only when serving over HTTPS. Leave 0 for local development.
COOKIE_SECURE=0
